// EXAMPLE: a creature enemy built on DFU's Orc, made weaker and quicker.
// Never spawns by itself. Try it in game with:  anpc_spawn example_creature
{
  "$schema": "../_Schemas/npc.schema.json",

  "kind": "generic",
  "name": "Example Orc Runt",

  // Any DFU creature works for hostile ANPCs (Rat, Spider, Orc, SkeletalWarrior, Zombie, Lich, ...).
  // It gets that creature's stats, attacks, sounds and picture (unless this folder has sprites).
  "baseClass": "Orc",

  // Creatures are always hostile.
  "attitude": "hostile",

  // Brave: never flees.
  "bravery": "Brave",

  "spawn": { "count": [0, 0] },

  "combat": {
    // 70% of the Orc's health and melee damage ("damage" works for creatures only).
    "health": 0.7,
    "damage": 0.7,
    // Attacks 1.3x as often.
    "attackSpeed": 1.3,
    // Creatures have no bow: with true they throw now and then at 6-51 m, then close in to melee.
    // Put a projectile.png in the sprite folder to show what flies (DFU's arrow otherwise).
    "rangedAtDistance": true,
    "projectileDamage": [2, 4]
  },

  // Makes the whole sprite smaller or bigger (0.2 to 2). 0.72 = goblin-sized.
  "spriteScale": 0.72
}
