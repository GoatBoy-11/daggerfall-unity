{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANPC named spot",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "position": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      }
    },
    "relativeTo": {
      "enum": [
        "home",
        "area"
      ],
      "default": "home"
    },
    "location": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "place": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "pattern": "^(outdoors|dungeon|b[0-9]+)?$",
          "default": "outdoors"
        }
      },
      "required": [
        "region",
        "place"
      ],
      "additionalProperties": false
    },
    "tags": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      ]
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 1
    },
    "facing": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    }
  },
  "required": [
    "position"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "relativeTo": {
            "const": "area"
          }
        },
        "required": [
          "relativeTo"
        ]
      },
      "then": {
        "required": [
          "location"
        ]
      }
    }
  ]
}
